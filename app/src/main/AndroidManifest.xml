<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Permissions -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"/>
    <uses-permission android:name="android.permission.VIBRATE"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"/>

    <!-- Needed so the medicine alarm can bypass Do Not Disturb -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY"/>

    <!-- Needed so the alarm page can full-screen launch over lock screen / DND on Android 14+ -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT"/>

    <uses-permission
        android:name="android.permission.INTERNET" />

    <uses-permission
        android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- Needed to read the currently-connected Wi-Fi SSID on Android 8+
         so the Home screen can confirm the phone is on MedAlarm-Setup -->
    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- Used by the Emergency tab's live map preview to center on the
         device's current location (falls back to this if fine/GPS location
         isn't available). -->
    <uses-permission
        android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <uses-permission
        android:name="android.permission.CHANGE_WIFI_STATE" />
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.ESPMEDALARM">

        <!-- Alarm Activity -->
        <activity
            android:name=".activities.AlarmActivity"
            android:exported="false"
            android:showOnLockScreen="true"
            android:turnScreenOn="true" />

        <!-- Add Medicine -->
        <activity
            android:name=".activities.AddMedicineActivity"
            android:exported="false" />

        <!-- Medicine Details -->
        <activity
            android:name=".activities.MedicineDetailsActivity"
            android:exported="false" />

        <!-- Main Activity -->
        <activity
            android:name=".activities.MainActivity"
            android:exported="false" />

        <!-- Login (launcher) -->
        <activity
            android:name=".activities.LoginActivity"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>

        </activity>

        <!-- Signup -->
        <activity
            android:name=".activities.SignupActivity"
            android:exported="false" />

        <!-- Admin Panel (password-gated) -->
        <activity
            android:name=".activities.AdminLoginActivity"
            android:exported="false" />

        <activity
            android:name=".activities.AdminPanelActivity"
            android:exported="false" />

        <!-- Alarm Receiver -->
        <receiver
            android:name=".receiver.AlarmReceiver"
            android:exported="false" />

        <!-- Alarm Service -->
        <service
            android:name=".service.AlarmService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback"/>

    </application>

</manifest>
